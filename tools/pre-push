#!/bin/sh
# Runs the job's own checks before anything is pushed. A failing check here would make the hourly job skip "Read prices",
# so the push is stopped instead. Install: cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
cd "$(git rev-parse --show-toplevel)" || exit 1
out=$(node build/test.js 2>&1); code=$?
if [ $code -ne 0 ]; then echo "$out" | tail -20; echo "PUSH STOPPED: the job's checks fail – fix them first."; exit 1; fi
echo "$out" | tail -1
